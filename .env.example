# Netskope API Configuration
# Copy this file to .env and fill in your credentials

# Your Netskope tenant name (e.g., 'yourcompany' for yourcompany.goskope.com)
NETSKOPE_TENANT=your-tenant-name

# Your Netskope API token
# Generate this from Settings > Tools > REST API v2 in your Netskope tenant
NETSKOPE_API_TOKEN=your-api-token-here

# Organization name for policy naming
ORGANIZATION_NAME=Your Healthcare Organization

# Optional: API version (default: v2)
NETSKOPE_API_VERSION=v2

# Optional: Request timeout in seconds (default: 30)
NETSKOPE_TIMEOUT=30

# Optional: Enable debug logging (default: false)
ENABLE_DEBUG_LOGGING=false
