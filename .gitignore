# Netskope Policy .gitignore

# Environment files with credentials
.env
*.env
!.env.example

# Configuration files with credentials
config/netskope_config.json
!config/netskope_config.json.example

# API tokens and secrets
*.token
*.key
secrets/

# Log files
logs/
*.log

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Deployment results
deployment_results_*.json
policies_export_*.json
*_backup.json

# Temporary files
*.tmp
temp/
.cache/

# OS
Thumbs.db
.DS_Store
